# Agent env example
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=...
TAVILY_API_KEY=tvly-...

# Backend API
BACKEND_API_URL=http://localhost:8000/api/v1
BACKEND_API_KEY=optional-when-deploy

# Agent config
N_RUNS_PER_PROMPT=3
STABILITY_THRESHOLD=0.7
ENABLE_HITL_SENTIMENT=true
ENABLE_HITL_HALLUCINATION=true
