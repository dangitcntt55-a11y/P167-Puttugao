# Gitignore — root cho cả repo

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.vscode/
.idea/
# .cursor/ ignored by default, but track hook configs
.cursor/*
!.cursor/hooks.json

# Common
*.log
*.tmp
*.bak

# Env files (only commit .env.example)
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Node
node_modules/
.next/
out/
.npm
.eslintcache

# Database
*.db
*.sqlite
*.sqlite3

# Generated
frontend/.next/
backend/.pytest_cache/
data/.ipynb_checkpoints/

# Misc
*.tsbuildinfo
P-167/