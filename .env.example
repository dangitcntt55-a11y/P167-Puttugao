# Root env example — copy thành `.env` ở mỗi folder cần dùng
# KHÔNG commit .env thật

# AI APIs
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=...
TAVILY_API_KEY=tvly-...

# Backend
DATABASE_URL=postgresql://geo:geo@localhost:5432/geo_ecom_dev
REDIS_URL=redis://localhost:6379/0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# App
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# Cost
COST_BUDGET_PER_SCAN_USD=0.30

# Stability
N_RUNS_PER_PROMPT=3
STABILITY_THRESHOLD=0.7
