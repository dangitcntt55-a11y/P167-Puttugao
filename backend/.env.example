# Backend env example — copy thành .env và điền giá trị thật
# KHÔNG commit .env thật

# Database
DATABASE_URL=postgresql://geo:geo@localhost:5432/geo_ecom_dev
REDIS_URL=redis://localhost:6379/0

# AI APIs (copy từ root .env hoặc giữ riêng)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=...
TAVILY_API_KEY=tvly-...

# App
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# Cost
COST_BUDGET_PER_SCAN_USD=0.30
